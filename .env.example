# URL do projeto Supabase (Settings > API)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave PUBLICÁVEL (sb_publishable_...). Nunca coloque a secret/service_role aqui.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Domínio interno usado para transformar username em e-mail de login.
# Deve ser igual ao USERNAME_EMAIL_DOMAIN da Edge Function auth-signup (padrão abaixo).
VITE_USERNAME_EMAIL_DOMAIN=jogadores.fazenda.invalid
